# =========================
# VARIABLES BASE
# =========================
export PROJECT_ID="iris-491522"
export REGION="us-west1"
export SERVICE_NAME="backend"
export REPOSITORY="iris-backend-docker"
export IMAGE_NAME="iris-backend"
export IMAGE_TAG="v2"

export CLOUDSQL_INSTANCE="iris-491522:us-central1:irisproductiondb"
export DB_NAME="irisproductiondb"
export DB_USER="backend"

export APP_URL="https://app.midominio.com"
export CORS_ORIGINS="https://frontend-1069972740102.us-west1.run.app"

export IMAGE_URI="${REGION}-docker.pkg.dev/${PROJECT_ID}/${REPOSITORY}/${IMAGE_NAME}:${IMAGE_TAG}"

# =========================
# SECRETOS
# =========================
# Crea el secreto del password de BD
printf ',*n2PqX)z`V=\Z1_' | gcloud secrets create DB_PASS --data-file=- || \
printf ',*n2PqX)z`V=\Z1_' | gcloud secrets versions add DB_PASS --data-file=-

# Crea el secreto del JWT
printf '[F6PB[-gDOwgaLj.$cfbFP58^Bw{f*FUQq5?&xuVkxIAzNVBe:Vk8p7xJ/[L[95J' | gcloud secrets create JWT_SECRET --data-file=- || \
printf '[F6PB[-gDOwgaLj.$cfbFP58^Bw{f*FUQq5?&xuVkxIAzNVBe:Vk8p7xJ/[L[95J' | gcloud secrets versions add JWT_SECRET --data-file=-

# =========================
# DESPLIEGUE CLOUD RUN
# =========================
gcloud run deploy "${SERVICE_NAME}" \
  --image "${IMAGE_URI}" \
  --project "${PROJECT_ID}" \
  --region "${REGION}" \
  --platform managed \
  --allow-unauthenticated \
  --add-cloudsql-instances "${CLOUDSQL_INSTANCE}" \
  --set-env-vars "APP_URL=${APP_URL}" \
  --set-env-vars "^@^CORS_ORIGINS=https://frontend-1069972740102.us-west1.run.app" \
  --set-env-vars "DB_NAME=${DB_NAME}" \
  --set-env-vars "DB_USER=${DB_USER}" \
  --set-env-vars "INSTANCE_CONNECTION_NAME=${CLOUDSQL_INSTANCE}" \
  --set-env-vars "INSTANCE_UNIX_SOCKET=/cloudsql/${CLOUDSQL_INSTANCE}" \
  --set-secrets "DB_PASSWORD=DB_PASS:latest" \
  --set-secrets "JWT_SECRET=JWT_SECRET:latest"